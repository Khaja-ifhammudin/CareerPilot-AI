# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/careerpilot-ai

# NextAuth / Auth.js secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=development-secret-careerpilot-ai-secure-token-2026

# Google Gemini API Key
GEMINI_API_KEY=

# Public application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
